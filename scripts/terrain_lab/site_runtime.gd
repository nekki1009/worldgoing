static func trade_endpoint(data: TerrainData, holder_id: String) -> Dictionary:
	if data == null or data.site.is_empty(): return fail("NO_TARGET")
	var endpoint: Dictionary = {}
	if holder_id == "depot":
		endpoint = {"holder": data.site.get("depot_items", {}), "cargo": data.site.get("inventory", {}), "capacity": data.site.get("capacity", -1)}
	elif holder_id.begins_with("person:"):
		var suffix: String = holder_id.trim_prefix("person:")
		if not suffix.is_valid_int() or str(int(suffix)) != suffix or not _building_integer(int(suffix), 1, 2147483647): return fail("INVALID")
		var actions: Variant = _technology_actions(data)
		if actions == null: return fail("UNSUPPORTED", "原人物 owner 尚未綁定")
		# Nekki 2026-11-06 "A" (trade T1): a crowd person trades like anyone else, in peace only (the same rule as
		# crowd equipment orders: no Site combat and the person is not fighting).
		var guard: Dictionary = actions.crowd_equipment_guard([int(suffix)])
		if not guard.ok: return fail("BUSY", "戰鬥中不能交易")
		var person: Dictionary = actions._person(int(suffix))
		if person.is_empty(): return fail("NO_TARGET")
		if not person.owner is TerrainArmy and not person.owner is TerrainTestCharacter and not person.owner is CrowdPersonOwner: return fail("UNSUPPORTED")
		if person.body is Dictionary and str(person.body.get("embarked_vehicle_id", "")) != "": return fail("UNSUPPORTED", "T0不支援登船人物")
		if actions.lab.site_controller != null and actions.lab.site_controller.vehicles.is_embarked(int(suffix)): return fail("UNSUPPORTED")
		endpoint = {"holder": person.holder, "cargo": person.cargo, "capacity": CARRY_CAPACITY}
	elif holder_id.begins_with("feature:"):
		var key: String = holder_id.trim_prefix("feature:")
		var stock_owner: Script = load("res://scripts/terrain_lab/site_stockpiles.gd")
		endpoint = stock_owner.call("stock_endpoint", data, key)
		var feature: Dictionary = data.site.get("features", {}).get(key, {})
		if endpoint.is_empty(): return fail("NO_TARGET")
		if endpoint.get("withdraw_only", true) or feature.has("pending_build") or feature.has("repair"): return fail("BUSY", "原設施禁止進料")
	elif holder_id.begins_with("vehicle:"):
		var key: String = holder_id.trim_prefix("vehicle:")
		var vehicle: Dictionary = data.site.get("vehicles", {}).get(key, {})
		if vehicle.is_empty(): return fail("NO_TARGET")
		if str(vehicle.get("kind", "")) not in ["cart", "wagon"]: return fail("UNSUPPORTED", "T0只支援停穩陸車")
		if not vehicle.get("move") is Dictionary or not vehicle.move.is_empty() or vehicle.get("stop_pending", false): return fail("BUSY")
		var transport_owner: Script = load("res://scripts/terrain_lab/site_vehicle_transport.gd")
		var reserved: Variant = vehicle.get("travel_patients", {}).get("reserved_capacity", 0)
		if not reserved is int or int(reserved) < 0: return fail("INVALID")
		endpoint = {"holder": vehicle.get("holder", {}), "cargo": vehicle.get("cargo", {}), "capacity": int(transport_owner.call("capacity_of", vehicle)) - int(reserved)}
	else:
		return fail("UNSUPPORTED", "T0不支援此持物端點（含team_supply）")
	if not endpoint.get("holder") is Dictionary or not _item_holder_shape(endpoint.holder) or endpoint.holder.holder != holder_id \
		or not endpoint.get("cargo") is Dictionary or not _resource_stack(endpoint.cargo) \
		or not endpoint.get("capacity") is int or int(endpoint.capacity) < 0: return fail("INVALID", "原持物端點不合法")
	var load_value: float = carried_load(data.site, endpoint.cargo, endpoint.holder)
	if not is_finite(load_value) or load_value < 0.0: return fail("INVALID")
	return ok("", endpoint)

static func _trade_ref_valid(ref: Dictionary) -> bool:
	return Technology.keys(ref, ["holder", "expected_version"]) and ref.holder is String and str(ref.holder).length() <= 128 \
		and ref.expected_version is int and int(ref.expected_version) >= 0 and int(ref.expected_version) < 2147483646

static func _trade_goods_valid(data: TerrainData, endpoint: Dictionary, goods: Dictionary) -> Dictionary:
	if not Technology.keys(goods, ["resources", "item_ids"]) or not goods.resources is Dictionary or not _resource_stack(goods.resources, false) \
		or not goods.item_ids is Array or goods.item_ids.size() > 1000000: return fail("INVALID")
	for resource: String in goods.resources:
		if resource == "coin": return fail("INVALID", "coin是計價單位，不是T0交換物資")
	if goods.resources.is_empty() and goods.item_ids.is_empty(): return fail("EMPTY", "交易雙方都須有付出")
	var selected: Dictionary = {}
	for identity: Variant in goods.item_ids:
		if not identity is String or selected.has(identity): return fail("INVALID")
		selected[identity] = true
		var record: Variant = data.site.item_records.get(identity)
		if not record is Dictionary or not valid_item_definition(record.get("definition"), data.site.item_definitions.get(record.get("definition"))): return fail("INVALID", "未知或毀損的原物品定義")
		for slot: String in endpoint.holder.equipped:
			if endpoint.holder.equipped[slot] == identity: return fail("UNSUPPORTED", "請先沿原入口卸裝")
	return ok()

static func prepare_item_exchange(data: TerrainData, a_ref: Dictionary, b_ref: Dictionary, a_gives: Dictionary, b_gives: Dictionary) -> Dictionary:
	if data == null or not data.site.get("item_records") is Dictionary or not data.site.get("item_definitions") is Dictionary \
		or not _trade_ref_valid(a_ref) or not _trade_ref_valid(b_ref) or a_ref.holder == b_ref.holder: return fail("INVALID")
	var a: Dictionary = trade_endpoint(data, str(a_ref.holder))
	if not a.ok: return a
	var b: Dictionary = trade_endpoint(data, str(b_ref.holder))
	if not b.ok: return b
	if is_same(a.holder, b.holder) or is_same(a.cargo, b.cargo): return fail("INVALID", "原持物端點不可共用字典")
	for pair: Array in [[a, a_gives], [b, b_gives]]:
		var checked: Dictionary = _trade_goods_valid(data, pair[0], pair[1])
		if not checked.ok: return checked
	var a_copy: Dictionary = a_gives.duplicate(true)
	var b_copy: Dictionary = b_gives.duplicate(true)
	if not can_pay(a.cargo, a_copy.resources) or not can_pay(b.cargo, b_copy.resources): return fail("EMPTY")
	var prepared: Dictionary = ok("", {"terrain": data, "site_state": data.site, "item_records": data.site.item_records,
		"a_ref": a_ref.duplicate(), "b_ref": b_ref.duplicate(), "a": a, "b": b, "a_gives": a_copy, "b_gives": b_copy,
		"a_before": a.holder.duplicate(true), "b_before": b.holder.duplicate(true), "a_cargo_before": a.cargo.duplicate(), "b_cargo_before": b.cargo.duplicate(),
		"a_load_before": carried_load(data.site, a.cargo, a.holder), "b_load_before": carried_load(data.site, b.cargo, b.holder)})
	var net_a: Dictionary = a.cargo.duplicate()
	var net_b: Dictionary = b.cargo.duplicate()
	add_items(net_a, a_copy.resources, -1)
	add_items(net_a, b_copy.resources)
	add_items(net_b, b_copy.resources, -1)
	add_items(net_b, a_copy.resources)
	if not _resource_stack(net_a) or not _resource_stack(net_b): return fail("INVALID", "交換後資源堆疊不合法")
	# Derived net allowance, never a caller-provided capacity. Both guards run on original owners.
	var allowance_b: int = int(b.capacity) + inventory_size(b_copy.resources) + b_copy.item_ids.size()
	var leg_a: Dictionary = prepare_item_transfer(data, a.holder, a.cargo, b.holder, b.cargo, a_copy.resources, a_copy.item_ids, int(a_ref.expected_version), int(b_ref.expected_version), allowance_b)
	if not leg_a.ok: return leg_a
	var allowance_a: int = int(a.capacity) + inventory_size(a_copy.resources) + a_copy.item_ids.size()
	var leg_b: Dictionary = prepare_item_transfer(data, b.holder, b.cargo, a.holder, a.cargo, b_copy.resources, b_copy.item_ids, int(b_ref.expected_version), int(a_ref.expected_version), allowance_a)
	if not leg_b.ok: return leg_b
	prepared["legs"] = [leg_a, leg_b]
	var stable: Dictionary = validate_prepared_item_exchange(prepared)
	return prepared if stable.ok else stable

static func validate_prepared_item_exchange(prepared: Dictionary) -> Dictionary:
	if prepared.get("ok") != true or not prepared.get("terrain") is TerrainData or not prepared.get("legs") is Array or prepared.legs.size() != 2: return fail("INVALID")
	for field: String in ["site_state", "item_records", "a_ref", "b_ref", "a", "b", "a_gives", "b_gives", "a_before", "b_before", "a_cargo_before", "b_cargo_before"]:
		if not prepared.get(field) is Dictionary: return fail("INVALID")
	for side: String in ["a", "b"]:
		if not _building_number(prepared.get(side + "_load_before"), 0.0, 1.0e12): return fail("INVALID")
	for leg: Variant in prepared.legs:
		if not leg is Dictionary or not leg.get("source") is Dictionary or not leg.get("source_cargo") is Dictionary \
			or not leg.get("destination") is Dictionary or not leg.get("destination_cargo") is Dictionary \
			or not leg.get("resources") is Dictionary or not leg.get("selected") is Dictionary \
			or not leg.get("retained_slots") is Dictionary or not leg.get("preserve_slots") is bool: return fail("INVALID")
	var data: TerrainData = prepared.terrain
	if not is_same(data.site, prepared.site_state) or not is_same(data.site.get("item_records"), prepared.item_records): return fail("STALE_SOURCE")
	for side: String in ["a", "b"]:
		var ref: Dictionary = prepared[side + "_ref"]
		if not _trade_ref_valid(ref): return fail("INVALID")
		var current: Dictionary = trade_endpoint(data, str(ref.holder))
		if not current.ok: return current
		var original: Dictionary = prepared[side]
		if not is_same(current.holder, original.holder) or not is_same(current.cargo, original.cargo) \
			or current.holder != prepared[side + "_before"] or current.cargo != prepared[side + "_cargo_before"] \
			or int(current.holder.version) != int(ref.expected_version) or current.capacity != original.capacity \
			or carried_load(data.site, current.cargo, current.holder) != float(prepared[side + "_load_before"]): return fail("STALE_SOURCE")
		var own: Dictionary = prepared[side + "_gives"]
		var incoming: Dictionary = prepared[("b" if side == "a" else "a") + "_gives"]
		var goods_check: Dictionary = _trade_goods_valid(data, current, own)
		if not goods_check.ok: return goods_check
		var final_load: float = carried_load(data.site, current.cargo, current.holder) - inventory_size(own.resources) - own.item_ids.size() + inventory_size(incoming.resources) + incoming.item_ids.size()
		if final_load > int(current.capacity): return fail("STORAGE_FULL")
		var net: Dictionary = current.cargo.duplicate()
		add_items(net, own.resources, -1)
		add_items(net, incoming.resources)
		if not _resource_stack(net): return fail("INVALID")
	for index: int in range(2):
		var leg: Dictionary = prepared.legs[index]
		var goods: Dictionary = prepared.a_gives if index == 0 else prepared.b_gives
		var source: Dictionary = prepared.a if index == 0 else prepared.b
		var destination: Dictionary = prepared.b if index == 0 else prepared.a
		if not is_same(leg.source, source.holder) or not is_same(leg.source_cargo, source.cargo) \
			or not is_same(leg.destination, destination.holder) or not is_same(leg.destination_cargo, destination.cargo) \
			or leg.resources != goods.resources or leg.selected.size() != goods.item_ids.size(): return fail("INVALID")
		for identity: String in goods.item_ids:
			if not leg.selected.has(identity): return fail("INVALID")
		var stable: Dictionary = validate_prepared_item_transfer(leg)
		if not stable.ok: return stable
	return ok()

static func publish_item_exchange(prepared: Dictionary) -> Dictionary:
	var stable: Dictionary = validate_prepared_item_exchange(prepared)
	if not stable.ok: return stable
	# Validation is complete; no callback/yield/save boundary inside this commit.
	for leg: Dictionary in prepared.legs: _publish_item_transfer_contents(leg)
	prepared.a.holder.version = int(prepared.a_ref.expected_version) + 1
	prepared.b.holder.version = int(prepared.b_ref.expected_version) + 1
	return ok("原物品已同次交換", {"a_version": prepared.a.holder.version, "b_version": prepared.b.holder.version})

# T6 S1: N-holder atomic candidate, zero tax. Holders are listed once in refs. Several transfers
# may touch one holder: its net effect is validated once and its version is bumped once.
# Outgoing goods and items must come from the ORIGINAL holder (incoming goods in the same
# candidate cannot be spent again), so there is no circular virtual balance. exchange_items
# keeps its own two-leg path unchanged.
const MAX_CANDIDATE_HOLDERS := 8
const MAX_CANDIDATE_TRANSFERS := 32

static func exchange_candidate(data: TerrainData, refs: Array, transfers: Array, preview: bool = false) -> Dictionary:
	var prepared: Dictionary = prepare_item_candidate(data, refs, transfers)
	if not prepared.ok: return prepared
	return ok() if preview else publish_item_candidate(prepared)

static func prepare_item_candidate(data: TerrainData, refs: Array, transfers: Array) -> Dictionary:
	return _prepare_candidate(data, refs, transfers, "", 0)

# T6 S4: collector_id is "" and percent 0 for the zero-tax S1 path. With percent > 0 the collector
# must be listed in refs; every other holder's incoming RESOURCES are taxed floor(received * percent / 100)
# per resource and that tax is added to the collector. Items are never taxed; the collector's own
# incoming goods are not taxed.
static func _prepare_candidate(data: TerrainData, refs: Array, transfers: Array, collector_id: String, percent: int, coin_transfers: Array = []) -> Dictionary:
	if data == null or not data.site.get("item_records") is Dictionary or not data.site.get("item_definitions") is Dictionary \
		or refs.size() < 2 or refs.size() > MAX_CANDIDATE_HOLDERS or (transfers.is_empty() and coin_transfers.is_empty()) \
		or transfers.size() + coin_transfers.size() > MAX_CANDIDATE_TRANSFERS:
		return fail("INVALID")
	var endpoints: Dictionary = {}
	var order: Array[String] = []
	for ref: Variant in refs:
		if not ref is Dictionary or not _trade_ref_valid(ref): return fail("INVALID")
		var holder_id: String = str(ref.holder)
		if endpoints.has(holder_id): return fail("INVALID", "同一持有人只能列一次")
		var endpoint: Dictionary = trade_endpoint(data, holder_id)
		if not endpoint.ok: return endpoint
		endpoints[holder_id] = endpoint
		order.append(holder_id)
	for index: int in range(order.size()):
		for other: int in range(index + 1, order.size()):
			var first: Dictionary = endpoints[order[index]]
			var second: Dictionary = endpoints[order[other]]
			if is_same(first.holder, second.holder) or is_same(first.cargo, second.cargo): return fail("INVALID", "原持物端點不可共用字典")
	var out_res: Dictionary = {}
	var in_res: Dictionary = {}
	var out_ids: Dictionary = {}
	var in_ids: Dictionary = {}
	var used: Dictionary = {}
	for holder_id: String in order:
		out_res[holder_id] = {}
		in_res[holder_id] = {}
		out_ids[holder_id] = []
		in_ids[holder_id] = []
		used[holder_id] = false
	if collector_id != "":
		if not endpoints.has(collector_id): return fail("INVALID", "收稅持有人須列入候選")
		used[collector_id] = true
	var selected: Dictionary = {}
	# T6 S5: coin payment legs follow the goods legs. They are the only legs allowed to carry coin (D-T7).
	var legs: Array = transfers.duplicate()
	legs.append_array(coin_transfers)
	for index: int in range(legs.size()):
		var transfer: Variant = legs[index]
		if not transfer is Dictionary or not Technology.keys(transfer, ["from", "to", "resources", "item_ids"]) \
			or not transfer.from is String or not transfer.to is String: return fail("INVALID")
		var source_id: String = transfer.from
		var dest_id: String = transfer.to
		if source_id == dest_id or not endpoints.has(source_id) or not endpoints.has(dest_id): return fail("INVALID")
		var source: Dictionary = endpoints[source_id]
		var destination: Dictionary = endpoints[dest_id]
		var goods: Dictionary = {"resources": transfer.resources, "item_ids": transfer.item_ids}
		var checked: Dictionary = {}
		if index < transfers.size():
			checked = _trade_goods_valid(data, source, goods)
		else:
			checked = _coin_leg_valid(goods)
		if not checked.ok: return checked
		for identity: String in transfer.item_ids:
			if selected.has(identity): return fail("INVALID", "同一物品只能出現一次")
			selected[identity] = true
			if str(data.site.item_records[identity].get("holder", "")) != source_id or not source.holder.item_ids.has(identity):
				return fail("STALE_SOURCE", "物品不在付出方")
		if data.item_transfer_guard.is_valid():
			var guard: Dictionary = data.item_transfer_guard.call(source.holder, destination.holder, transfer.resources, transfer.item_ids)
			if not guard.ok: return guard
		add_items(out_res[source_id], transfer.resources)
		add_items(in_res[dest_id], transfer.resources)
		out_ids[source_id].append_array(transfer.item_ids)
		in_ids[dest_id].append_array(transfer.item_ids)
		used[source_id] = true
		used[dest_id] = true
	# T6 S4 in-kind tax: floor per resource on each non-collector side's incoming resources, paid to the collector.
	var taxed: Dictionary = {}
	if collector_id != "" and percent > 0:
		var collected: Dictionary = {}
		for holder_id: String in order:
			if holder_id == collector_id: continue
			var incoming: Dictionary = in_res[holder_id]
			var before: Dictionary = incoming.duplicate()
			var levied: Dictionary = {}
			for key: Variant in before.keys():
				var resource: String = str(key)
				var tax: int = int(before[resource]) * percent / 100
				if tax > 0:
					levied[resource] = tax
					incoming[resource] = int(incoming[resource]) - tax
					collected[resource] = int(collected.get(resource, 0)) + tax
			taxed[holder_id] = {"received": before, "tax": levied}
		add_items(in_res[collector_id], collected)
	var plan: Array = []
	for holder_id: String in order:
		if not bool(used[holder_id]): return fail("INVALID", "持有人未參與任何移轉")
		var endpoint: Dictionary = endpoints[holder_id]
		if not can_pay(endpoint.cargo, out_res[holder_id]): return fail("EMPTY")
		var after_cargo: Dictionary = endpoint.cargo.duplicate()
		add_items(after_cargo, out_res[holder_id], -1)
		add_items(after_cargo, in_res[holder_id])
		for key: Variant in after_cargo.keys():
			if int(after_cargo[key]) == 0: after_cargo.erase(key)
		if not _resource_stack(after_cargo): return fail("INVALID", "交換後資源堆疊不合法")
		var load_before: float = carried_load(data.site, endpoint.cargo, endpoint.holder)
		var load_after: float = load_before + float(inventory_size(after_cargo) - inventory_size(endpoint.cargo)) \
			+ float(in_ids[holder_id].size() - out_ids[holder_id].size())
		if not is_finite(load_after) or load_after > float(int(endpoint.capacity)): return fail("STORAGE_FULL")
		var detail: Dictionary = taxed.get(holder_id, {})
		plan.append({"id": holder_id, "endpoint": endpoint, "version": int(refs_version(refs, holder_id)),
			"cargo_before": endpoint.cargo.duplicate(), "items_before": endpoint.holder.item_ids.duplicate(),
			"load_before": load_before, "cargo_after": after_cargo,
			"out_ids": out_ids[holder_id].duplicate(), "in_ids": in_ids[holder_id].duplicate(),
			"received": detail.get("received", {}), "tax": detail.get("tax", {})})
	var prepared: Dictionary = ok("", {"terrain": data, "site_state": data.site, "item_records": data.site.item_records, "plan": plan})
	var stable: Dictionary = validate_prepared_item_candidate(prepared)
	return prepared if stable.ok else stable

# T6 S5 (D-T7): a coin payment leg carries exactly one resource, "coin", with a positive integer amount and no items.
static func _coin_leg_valid(goods: Dictionary) -> Dictionary:
	if not Technology.keys(goods, ["resources", "item_ids"]) or not goods.resources is Dictionary or goods.resources.size() != 1:
		return fail("INVALID", "硬幣付款腿只能有單一 coin 數量")
	if not goods.resources.has("coin") or not goods.item_ids is Array or not goods.item_ids.is_empty():
		return fail("INVALID", "硬幣付款腿只能有 coin 且不可帶物品")
	var amount: Variant = goods.resources.coin
	if not amount is int or int(amount) < 1 or int(amount) > 1000000: return fail("INVALID", "硬幣數量不合法")
	return ok()

## T6 S5: the S1 candidate with coin payment legs. Coin legs are checked against the ORIGINAL cargo like goods.
static func prepare_candidate_with_coin(data: TerrainData, refs: Array, transfers: Array, coin_transfers: Array) -> Dictionary:
	return _prepare_candidate(data, refs, transfers, "", 0, coin_transfers)

static func refs_version(refs: Array, holder_id: String) -> int:
	for ref: Variant in refs:
		if ref is Dictionary and str(ref.holder) == holder_id: return int(ref.expected_version)
	return -1

static func validate_prepared_item_candidate(prepared: Dictionary) -> Dictionary:
	if prepared.get("ok") != true or not prepared.get("terrain") is TerrainData or not prepared.get("plan") is Array or prepared.plan.is_empty(): return fail("INVALID")
	var data: TerrainData = prepared.terrain
	if not is_same(data.site, prepared.get("site_state")) or not is_same(data.site.get("item_records"), prepared.get("item_records")): return fail("STALE_SOURCE")
	for record: Variant in prepared.plan:
		if not record is Dictionary or not record.get("endpoint") is Dictionary or not record.get("cargo_after") is Dictionary \
			or not record.get("out_ids") is Array or not record.get("in_ids") is Array or not record.get("items_before") is Array: return fail("INVALID")
		var current: Dictionary = trade_endpoint(data, str(record.id))
		if not current.ok: return current
		var original: Dictionary = record.endpoint
		if not is_same(current.holder, original.holder) or not is_same(current.cargo, original.cargo) \
			or int(current.holder.version) != int(record.version) or current.cargo != record.cargo_before \
			or current.holder.item_ids != record.items_before or carried_load(data.site, current.cargo, current.holder) != float(record.load_before) \
			or not _item_holder_shape(current.holder) or not _resource_stack(record.cargo_after): return fail("STALE_SOURCE")
		for identity: String in record.out_ids:
			if str(data.site.item_records.get(identity, {}).get("holder", "")) != str(record.id): return fail("STALE_SOURCE")
		for identity: String in record.in_ids:
			if current.holder.item_ids.has(identity): return fail("STALE_SOURCE")
	return ok()

static func publish_item_candidate(prepared: Dictionary) -> Dictionary:
	var stable: Dictionary = validate_prepared_item_candidate(prepared)
	if not stable.ok: return stable
	# Validation is complete; no callback/yield/save boundary inside this commit.
	var data: TerrainData = prepared.terrain
	var versions: Dictionary = {}
	for record: Dictionary in prepared.plan:
		var holder: Dictionary = record.endpoint.holder
		var cargo: Dictionary = record.endpoint.cargo
		cargo.clear()
		cargo.merge(record.cargo_after)
		for identity: String in record.out_ids:
			holder.item_ids.erase(identity)
		for identity: String in record.in_ids:
			holder.item_ids.append(identity)
			data.site.item_records[identity]["holder"] = str(record.id)
	for record: Dictionary in prepared.plan:
		record.endpoint.holder.version = int(record.version) + 1
		versions[str(record.id)] = int(record.version) + 1
	return ok("原物品已同次多端點交換", {"versions": versions})

# T6 S4: in-kind trade tax with per-side receipts. The rate is the settlement's trade_tax_percent (S2)
# and the collector is the nation's bound treasury (R4b-1). Rate 0 needs no collector and writes no
# receipt, so it is the S1 result exactly. A repeated trade_id returns its stored receipts and changes nothing.
const TRADE_TAX_MAX_PERCENT := 50 # Same bound as site_settlement.gd TRADE_TAX_MAX (S2).

static func _settlement_percent(data: TerrainData) -> int:
	var settlement: Variant = data.site.get("settlement", null)
	if settlement == null: return 0
	if not settlement is Dictionary: return -1
	var record: Dictionary = settlement
	if not record.has("trade_tax_percent"): return 0
	var value: Variant = record.trade_tax_percent
	if not value is int or int(value) < 0 or int(value) > TRADE_TAX_MAX_PERCENT: return -1
	return int(value)

static func trade_tax_terms(data: TerrainData) -> Dictionary:
	if data == null or data.site.is_empty(): return fail("NO_TARGET")
	var percent: int = _settlement_percent(data)
	if percent < 0: return fail("INVALID", "聚落貿易稅率不合法")
	if percent == 0: return ok("", {"percent": 0, "collector": "", "derived": true})
	var settlement: Dictionary = data.site.get("settlement", {})
	var nation_id: Variant = settlement.get("nation_id")
	var nations: Variant = data.site.get("equipment_nations", {})
	if not nation_id is String or not nations is Dictionary or not nations.get(nation_id) is Dictionary: return fail("NO_COLLECTOR", "聚落須隸屬已建立的本國")
	var nation: Dictionary = nations[nation_id]
	var ransom: Variant = nation.get("ransom_data", {})
	var treasury: Variant = {}
	if ransom is Dictionary: treasury = ransom.get("treasury", {})
	if not treasury is Dictionary or treasury.is_empty(): return fail("NO_COLLECTOR", "本國國庫未綁定")
	var holder: Variant = treasury.get("holder")
	if str(treasury.get("site_id", "")) != str(data.site.get("id", "")) or not holder is String or not str(holder).begins_with("feature:"):
		return fail("NO_COLLECTOR", "國庫不在本聚落")
	var feature: Variant = data.site.get("features", {}).get(str(holder).trim_prefix("feature:"))
	if not feature is Dictionary or str(feature.get("kind", "")) != "warehouse": return fail("NO_COLLECTOR", "國庫須為原倉庫")
	return ok("", {"percent": percent, "collector": str(holder), "derived": true})

static func _trade_id_valid(trade_id: String) -> bool:
	return not trade_id.is_empty() and trade_id.length() <= 64 and not trade_id.contains(":")

static func _trade_receipt_store(data: TerrainData) -> Dictionary:
	var store: Variant = data.site.get("trade_tax_receipts", {})
	if store is Dictionary: return store
	return {}

static func _trade_receipts_for(data: TerrainData, trade_id: String) -> Dictionary:
	var found: Dictionary = {}
	var store: Dictionary = _trade_receipt_store(data)
	for key: Variant in store.keys():
		if str(key).begins_with(trade_id + ":"): found[str(key)] = store[key]
	return found

static func exchange_taxed_candidate(data: TerrainData, refs: Array, transfers: Array, trade_id: String, preview: bool = false) -> Dictionary:
	var terms: Dictionary = trade_tax_terms(data)
	if not terms.ok: return terms
	return commit_taxed_candidate(data, refs, transfers, trade_id, terms, preview)

## Terms are passed in by the caller (exchange_taxed_candidate derives them); publish re-checks the rate and, for derived terms, the collector.
static func commit_taxed_candidate(data: TerrainData, refs: Array, transfers: Array, trade_id: String, terms: Dictionary, preview: bool = false) -> Dictionary:
	if data == null or not _trade_id_valid(trade_id): return fail("INVALID", "貿易編號不合法")
	# T6 S5C: one trade_id names one kind of receipt; an id used by a leg receipt (trade_leg_receipts) is refused.
	var leg_store: Variant = data.site.get("trade_leg_receipts", {})
	if leg_store is Dictionary:
		for leg_key: Variant in leg_store.keys():
			if str(leg_key).begins_with(trade_id + ":"): return fail("INVALID", "貿易編號已用於付款收據")
	var request: String = JSON.stringify(transfers)
	var existing: Dictionary = _trade_receipts_for(data, trade_id)
	if not existing.is_empty():
		for key: Variant in existing.keys():
			if str(existing[key].get("request", "")) != request: return fail("INVALID", "收據鍵已用於不同交易")
		return ok("重複提交：沿用原收據，未再收稅", {"replayed": true, "receipt_keys": existing.keys()})
	var prepared: Dictionary = prepare_taxed_candidate(data, refs, transfers, trade_id, terms)
	if not prepared.ok: return prepared
	return ok() if preview else publish_taxed_candidate(prepared)

static func prepare_taxed_candidate(data: TerrainData, refs: Array, transfers: Array, trade_id: String, terms: Dictionary) -> Dictionary:
	if not _trade_id_valid(trade_id) or not terms.get("percent") is int or not terms.get("collector") is String or not terms.get("derived") is bool:
		return fail("INVALID")
	var percent: int = int(terms.percent)
	var collector_id: String = str(terms.collector)
	if percent < 0 or percent > TRADE_TAX_MAX_PERCENT or (percent > 0) != (not collector_id.is_empty()): return fail("INVALID", "收稅持有人與稅率不一致")
	var prepared: Dictionary = _prepare_candidate(data, refs, transfers, collector_id, percent)
	if not prepared.ok: return prepared
	var request: String = JSON.stringify(transfers)
	var receipts: Array = []
	if percent > 0:
		for record: Dictionary in prepared.plan:
			var side: String = str(record.id)
			if side == collector_id or (record.received.is_empty() and record.in_ids.is_empty()): continue
			receipts.append({"key": trade_id + ":" + side, "record": {"trade_id": trade_id, "side": side, "collector": collector_id,
				"percent": percent, "received": record.received.duplicate(), "tax": record.tax.duplicate(), "items": record.in_ids.duplicate(), "request": request}})
	prepared["terms"] = terms.duplicate()
	prepared["receipts"] = receipts
	return prepared

static func publish_taxed_candidate(prepared: Dictionary) -> Dictionary:
	var stable: Dictionary = validate_prepared_item_candidate(prepared)
	if not stable.ok: return stable
	var data: TerrainData = prepared.terrain
	var terms: Dictionary = prepared.terms
	if _settlement_percent(data) != int(terms.percent): return fail("STALE_SOURCE", "聚落貿易稅率已改變")
	if bool(terms.derived):
		var now: Dictionary = trade_tax_terms(data)
		if not now.ok or int(now.percent) != int(terms.percent) or str(now.collector) != str(terms.collector): return fail("STALE_SOURCE", "收稅國庫已改變")
	var store: Dictionary = _trade_receipt_store(data)
	for entry: Dictionary in prepared.receipts:
		if store.has(str(entry.key)): return fail("STALE_SOURCE", "收據已存在")
	var committed: Dictionary = publish_item_candidate(prepared)
	if not committed.ok: return committed
	if not prepared.receipts.is_empty():
		if not data.site.get("trade_tax_receipts") is Dictionary: data.site["trade_tax_receipts"] = {}
		var saved: Dictionary = data.site["trade_tax_receipts"]
		var keys: Array = []
		for entry: Dictionary in prepared.receipts:
			saved[str(entry.key)] = entry.record
			keys.append(str(entry.key))
		committed["receipt_keys"] = keys
	return committed

# Author operations only prepare detached candidates; normal construction keeps its payment/work owners.
static func _author_building_guard(data: TerrainData, work: Dictionary) -> Dictionary:
	if data == null or work.get("kind") != "fixed_tw_editor_draft" or work.get("format") != 4: return fail("AUTHOR_ONLY")
	var base: Dictionary = data.parameters.get("fixed_base", {})
	if base.get("scenario_id") != "editor_draft" or base.get("scenario_revision") != work.get("revision") or base.get("manifest_sha256") != work.get("source_sha256") or data.site != work.get("initial_state"): return fail("AUTHOR_ONLY", "須使用同一修訂的已驗作者候選")
	if data.has_meta(&"site_garrison_lab") or data.has_meta(&"fire_event_guard") or data.has_meta(&"siege_event_guard"): return fail("AUTHOR_ONLY", "活動 owner 不可免費初始化")
	return Env.prepare_author_resource_state(data, data.site)

static func _author_feature_refs(value: Variant, key: String, path: String, refs: Array[String]) -> void:
	if value is Dictionary:
		for field: Variant in value:
			var at: String = path + "." + str(field)
			if str(field) in ["feature", "feature_id", "house_id", "home_id", "garrison_feature_id", "prison_id", "center_id", "training_feature_id", "source_feature_id", "upstream_feature_id", "yard_feature_id"] and str(value[field]) == key:
				refs.append(at)
			else: _author_feature_refs(value[field], key, at, refs)
	elif value is Array:
		for index: int in range(value.size()): _author_feature_refs(value[index], key, "%s[%d]" % [path, index], refs)
	elif value is String and value == "feature:" + key: refs.append(path)

static func author_feature_referrers(data: TerrainData, key: String) -> Array[String]:
	var refs: Array[String] = []
	var feature: Dictionary = data.site.features.get(key, {})
	for field: String in ["pending_build", "repair", "ship_build", "tech_batch", "technology_order", "technology_siege_yard", "technology_shipyard_work"]:
		if feature.has(field): refs.append("features." + key + "." + field)
	for field: String in ["gate", "ladder"]:
		if not str(feature.get(field, {}).get("pending", "")).is_empty(): refs.append("features." + key + "." + field)
	if bool(feature.get("batch_paid", false)) or float(feature.get("production", 0.0)) != 0.0: refs.append("features." + key + ".production")
	var stock: Dictionary = data.site.get("stockpiles", {}).get(key, {})
	if inventory_size(stock.get("cargo", {})) > 0: refs.append("stockpiles." + key + ".cargo")
	if not stock.get("holder", {}).get("item_ids", []).is_empty(): refs.append("stockpiles." + key + ".holder.item_ids")
	if stock.has("nation_id"): refs.append("stockpiles." + key + ".nation_id")
	for root: String in data.site:
		if root == "features":
			for other: String in data.site.features:
				if other != key: _author_feature_refs(data.site.features[other], key, "features." + other, refs)
		elif root == "settlement" and str(feature.get("kind")) == "settlement_center":
			for field: String in data.site.settlement:
				if field != "center_id": _author_feature_refs(data.site.settlement[field], key, "settlement." + field, refs)
		elif root != "stockpiles": _author_feature_refs(data.site[root], key, root, refs)
	if not data.site.get("fire", {}).is_empty(): refs.append("fire")
	return refs

static func validate_author_buildings(data: TerrainData) -> Dictionary:
	for key: String in data.site.features:
		var feature: Dictionary = data.site.features[key]
		if feature.get("stage") != "complete" or feature.has("pending_build") or feature.has("repair"): return fail("AUTHOR_BUILDING_STATE", "features." + key)
		var cells: Array[int] = []
		cells.assign(feature.cells)
		var preview: Dictionary = _preview_build(data, str(feature.kind), cells, Callable(), _feature_options(feature), key, false)
		if not preview.ok: return preview
		if not preview.clearing.is_empty(): return fail("AUTHOR_CLEARING_REQUIRED", "features." + key + ": " + str(preview.clearing))
		var layout: Dictionary = validate_feature_layout(data, feature)
		if not layout.ok: return layout
	return ok()

static func prepare_author_building(data: TerrainData, work: Dictionary, action: String, key: String = "", kind: String = "", cells: Array[int] = [], options: Dictionary = {}, cargo: Dictionary = {}) -> Dictionary:
	var admission: Dictionary = _author_building_guard(data, work)
	if not admission.ok: return admission
	if action not in ["place", "move", "copy", "delete", "owner", "stock"]: return fail("INVALID")
	if action in ["place", "move", "copy"] and cells.is_empty(): return fail("INVALID", "建物足跡不可空白")
	var candidate: TerrainData = Env.navigation_for_state(data, data.site.duplicate(true))
	var original: Dictionary = candidate.site.features.get(key, {})
	if action != "place" and original.is_empty(): return fail("NO_TARGET")
	if action in ["move", "delete", "owner"]:
		var refs: Array[String] = author_feature_referrers(candidate, key)
		if action == "move" and int(original.get("residents", 0)) > 0: refs.append("features." + key + ".residents")
		if not refs.is_empty():
			var rejected: Dictionary = fail("AUTHOR_REFERENCED", str(refs))
			rejected["referrers"] = refs
			return rejected
	if action == "stock":
		var normalized: Dictionary = {}
		for item: Variant in cargo:
			if not item is String or not _building_integer(cargo[item], 0, 1000000): return fail("INVALID", "庫房只接受原資源整數堆疊")
			normalized[item] = int(cargo[item])
		if not _resource_stack(normalized): return fail("INVALID")
		var storage: Dictionary = SiteStockpiles.ensure_storage(candidate, key, int(original.get("owner_faction", -1)))
		if not storage.ok: return storage
		if storage.stock.has("nation_id"): return fail("AUTHOR_REFERENCED", "stockpiles." + key + ".nation_id")
		if carried_size(normalized, storage.stock.holder) > SiteStockpiles.capacity(original): return fail("STORAGE_FULL")
		storage.stock.cargo = normalized
	elif action == "owner":
		if not _building_integer(options.get("owner_faction"), 0, 100000000): return fail("INVALID")
		original["owner_faction"] = int(options.owner_faction)
		if str(original.kind) == "settlement_center":
			var center_guard: Dictionary = _author_center_unbound(candidate)
			if not center_guard.ok: return center_guard
			candidate.site.settlement.owner_faction = int(options.owner_faction)
	elif action == "delete":
		var change: Dictionary = structure_change_guard(candidate, key, {}, Callable(), "remove")
		if not change.ok: return change
		var recovered: Dictionary = {}
		if str(original.kind) == "tent": recovered["camp_tent"] = 1
		if original.has("species"): recovered[str(original.species)] = int(original.residents)
		if not _depot_can_receive(candidate, recovered): return fail("STORAGE_FULL")
		if str(original.kind) == "settlement_center":
			var center_guard: Dictionary = _author_center_unbound(candidate)
			if not center_guard.ok: return center_guard
			candidate.site.erase("settlement")
		add_items(candidate.site.inventory, recovered)
		candidate.site.features.erase(key)
		candidate.site.get("stockpiles", {}).erase(key)
	else:
		var offset: Vector2i = Vector2i.ZERO
		if action in ["move", "copy"]:
			kind = str(original.kind)
			options = _feature_options(original)
			var old_bounds: Rect2i = _cell_bounds(data, original.cells)
			var new_bounds: Rect2i = _cell_bounds(data, cells)
			if old_bounds.size != new_bounds.size: return fail("AUTHOR_UNSUPPORTED", "搬移不得改變布局尺寸")
			var shifted: Array[int] = []
			offset = new_bounds.position - old_bounds.position
			for index: int in original.cells: shifted.append(data.index(data.cell_from_index(index) + offset))
			var expected: Array[int] = cells.duplicate()
			shifted.sort(); expected.sort()
			if shifted != expected: return fail("AUTHOR_UNSUPPORTED", "搬移只接受原足跡平移")
			if original.get("stage") != "complete" or original.has("pending_build") or original.has("repair") or bool(original.get("batch_paid", false)) or float(original.get("production", 0.0)) != 0.0: return fail("BUSY", "features." + key)
			if action == "copy" and kind == "tent":
				if not can_pay(candidate.site.inventory, {"camp_tent": 1}): return fail("MATERIALS", "複製營帳布局需原營地已有一個營帳包；不複製活資產")
				candidate.site.inventory["camp_tent"] = int(candidate.site.inventory.camp_tent) - 1
			if kind in WATERFRONT_KINDS:
				options["launch_cell"] = data.index(data.cell_from_index(int(original.launch_cell)) + offset)
		if kind in ["level", "survey_stakes", "irrigation_channel"]: return fail("AUTHOR_UNSUPPORTED", "整地沿地形工具；測量／渠道須原人物與科技作業閉包")
		if not _building_integer(options.get("owner_faction", -1), -1, 100000000) or not _building_integer(options.get("quarter", 0), 0, 3): return fail("INVALID")
		if action == "move":
			candidate.site.features.erase(key)
			Env.rebuild_indexes(candidate)
		var preview: Dictionary = _preview_build(candidate, kind, cells, Callable(), options, key if action == "move" else "", false)
		if not preview.ok: return preview
		if not preview.clearing.is_empty(): return fail("AUTHOR_CLEARING_REQUIRED", str(preview.clearing))
		var feature: Dictionary = _completed_tent_candidate(cells, preview) if kind == "tent" else _building_feature_candidate(kind, cells, preview)
		feature["stage"] = "complete"
		feature["progress"] = float(feature.work)
		feature["status"] = "作者初始完工"
		if action == "copy" and int(original.get("civil_version", 0)) == CIVIL_VERSION:
			feature = _civil_upgrade_candidate(feature, building_grade(original))
			feature["cost"] = original.cost.duplicate(true)
			feature["work"] = float(original.work)
			feature["progress"] = float(feature.work)
		if action == "move":
			feature = original.duplicate(true)
			feature["cells"] = cells.duplicate()
			feature["entrance"] = int(preview.entrance)
			feature["source"] = str(preview.source)
			feature["level"] = int(preview.level)
			if kind in WATERFRONT_KINDS: feature["launch_cell"] = int(preview.options.launch_cell)
			if original.has("parts"):
				var parts: Dictionary = {}
				for part_id: String in original.parts:
					var mapped: String = part_id
					if part_id.begins_with("c:") and part_id.get_slice(":", 1).is_valid_int(): mapped = "c:" + str(data.index(data.cell_from_index(int(part_id.get_slice(":", 1))) + offset))
					parts[mapped] = original.parts[part_id].duplicate(true)
				feature["parts"] = parts
			var guard: Dictionary = structure_change_guard(data, key, feature, Callable(), "move")
			if not guard.ok: return guard
		else:
			if not _building_integer(candidate.site.next_feature, 1, 999999): return fail("AUTHOR_ID_EXHAUSTED")
			key = str(int(candidate.site.next_feature))
			if candidate.site.features.has(key): return fail("STALE_SOURCE")
			candidate.site["next_feature"] = int(candidate.site.next_feature) + 1
			if action == "copy" and feature.has("residents"): feature["residents"] = 0
			if kind == "settlement_center":
				if candidate.site.has("settlement") or _settlement_center_count(candidate) > 0 or int(feature.owner_faction) < 0: return fail("AUTHOR_REFERENCED", "每Site只可有一座具明示管理方的中心")
				candidate.site["settlement"] = {"version": SiteSettlement.VERSION, "settlement_id": "settlement_%s_%s" % [str(candidate.site.id).left(64), key], "center_id": key, "level": 1, "name": "初始聚落", "owner_faction": int(feature.owner_faction), "offices": SiteOffices.default_offices("settlement"), "fall_record": SiteSettlement.empty_fall_record()}
		candidate.site.features[key] = feature
	Env.rebuild_indexes(candidate)
	var environment: Dictionary = validate_author_buildings(candidate)
	if not environment.ok: return environment
	var checked: Dictionary = Env.prepare_author_resource_state(candidate, candidate.site)
	if not checked.ok: return checked
	return ok("作者候選已驗證", {"state": checked.state, "feature": key, "asset_report": {"before": _author_building_assets(data.site), "after": _author_building_assets(checked.state)}})

static func _author_center_unbound(data: TerrainData) -> Dictionary:
	var record: Dictionary = SiteSettlement.record(data)
	for position: Dictionary in record.get("offices", {}).get("positions", []):
		if int(position.get("holder", -1)) > 0: return fail("AUTHOR_REFERENCED", "settlement.offices.positions." + str(position.id))
	var technology: Dictionary = record.get("technology", {})
	if not technology.get("known", []).is_empty() or not technology.get("projects", []).is_empty() or int(technology.get("active", 0)) != 0 or record.has("technology_operations"): return fail("AUTHOR_REFERENCED", "settlement.technology")
	var fall: Dictionary = record.get("fall_record", {})
	if not fall.get("last_fall", {}).is_empty() or float(fall.get("contest_seconds", 0.0)) != 0.0: return fail("AUTHOR_REFERENCED", "settlement.fall_record")
	return ok()

static func _author_building_assets(state: Dictionary) -> Dictionary:
	var resources: Dictionary = state.inventory.duplicate(true)
	for stock: Dictionary in state.get("stockpiles", {}).values(): add_items(resources, stock.cargo)
	for feature: Dictionary in state.features.values():
		if feature.get("kind") == "tent": resources["camp_tent"] = int(resources.get("camp_tent", 0)) + 1
		if feature.has("species"): resources[str(feature.species)] = int(resources.get(str(feature.species), 0)) + int(feature.residents)
	var item_ids: Array = state.get("item_records", {}).keys()
	item_ids.sort()
	return {"resources": resources, "item_ids": item_ids}
