# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Source models and baked binary resources use Git LFS, not Git text filters.
*.blend filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.vrm filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.res filter=lfs diff=lfs merge=lfs -text
*.scn filter=lfs diff=lfs merge=lfs -text
assets/characters/terrain_lab_army/standard_soldier/standard_soldier_collision.bin filter=lfs diff=lfs merge=lfs -text

# Formal art and audio added untracked before 2026-10-11 use Git LFS. Older tracked
# asset PNGs stay ordinary Git blobs; converting them would not shrink history.
assets/map/site/settlement/building_v2/*.png filter=lfs diff=lfs merge=lfs -text
assets/map/site/natural_resources/*.png filter=lfs diff=lfs merge=lfs -text
assets/vehicles/ships/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/vehicles/siege/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/audio/**/*.wav filter=lfs diff=lfs merge=lfs -text
